# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.

# Supabase projesi (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Sadece scripts/seed-catalog.ts için (RLS'i aşan sunucu anahtarı) —
# Dashboard → Project Settings → API keys → Secret keys. ASLA commit etmeyin.
# SUPABASE_SECRET_KEY=sb_secret_...

# Site mutlak URL'i (robots/sitemap/OG) — domain geçişinde sadece bu değişir.
NEXT_PUBLIC_SITE_URL=https://www.sqlcodex.com
